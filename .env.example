# NutriScan environment variables.
# Copy the API block to services/api/.env and the mobile block to apps/mobile/.env.
# Never commit real secrets; both .env files are git-ignored.

# ---------------------------------------------------------------- services/api/.env
# PostgreSQL connection (local dev cluster from scripts/dev-db.*, Docker Compose, or any PostgreSQL 14+ / cloud provider).
DATABASE_URL="postgresql://nutriscan@localhost:5433/nutriscan?schema=public"
# Used only by the automated tests; the tests truncate this database.
TEST_DATABASE_URL="postgresql://nutriscan@localhost:5433/nutriscan_test?schema=public"
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000
# Browser origins allowed by CORS (Expo web dev server). Native apps send no Origin and are allowed.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
# Behind a reverse proxy (for correct rate-limit IPs)
TRUST_PROXY="false"

# Optional Python ML inference service (ml/inference/server.py). If it is down, the ML screen says "unavailable".
ML_SERVICE_URL="http://127.0.0.1:8001"
ML_TIMEOUT_MS=4000

# Optional language model for the assistant. Default "none" = deterministic, fully offline answers.
#   none | ollama (free, local: https://ollama.com) | openai_compatible | anthropic (paid API)
LLM_PROVIDER="none"
# LLM_MODEL="llama3.2"                      # ollama default; anthropic default claude-opus-5-5
# LLM_BASE_URL="http://127.0.0.1:11434"     # ollama / openai-compatible endpoint
# LLM_API_KEY=""                            # openai_compatible / anthropic only - keep server-side
LLM_TIMEOUT_MS=20000

# Optional: look up unknown barcodes on Open Food Facts at request time (off by default, per the thesis design).
OFF_LIVE_LOOKUP="false"
OFF_USER_AGENT="NutriScan-Academic/1.0 (student project)"

# Optional: folder containing eng.traineddata for fully offline OCR (otherwise downloaded once and cached).
# OCR_LANG_PATH="C:/tessdata"

# ---------------------------------------------------------------- apps/mobile/.env
# Address of the API as seen from the phone/emulator (only public, non-secret values here):
#   Android emulator   http://10.0.2.2:4000
#   Physical device    http://<your computer's LAN IP>:4000
#   Web / iOS sim      http://localhost:4000
EXPO_PUBLIC_API_URL="http://localhost:4000"
